#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp GRAVE   &kp N1     &kp N2        &kp N3        &kp N4           &kp N5      &kp F1  &kp N6     &kp N7     &kp N8     &kp N9           &kp N0      &kp BACKSPACE
&kp ESC     &kp Q      &kp W         &kp E         &kp R            &kp T       &kp F2  &kp Y      &kp U      &kp I      &kp O            &kp P       &kp BSLH
&kp TAB     &kp A      &kp S         &kp D         &kp F            &kp G       &kp F3  &kp H      &kp J      &kp K      &kp L            &kp SEMI    &kp APOS
&kp LCTRL   &kp Z      &kp X         &kp C         &kp V            &kp B       &kp F4  &kp N      &kp M      &kp COMMA  &kp DOT          &kp FSLH    &kp RSHIFT
                                                                                &kp F5
            &kp LCTRL  &kp LEFT_ALT  &mo 2         &kp LEFT_GUI     &kp SPACE   &kp F6  &kp ENTER  &mo 1      &mo 2      &kp RSHIFT       &kp DELETE
            >;

            display-name = "base";
        };

        nav_layer {
            bindings = <
&kp GRAVE   &kp F1           &kp F2          &kp F3           &kp F4           &kp F5             &mmv MOVE_UP     &kp F6           &kp F7           &kp F8      &kp F9     &kp F10       &trans
&trans      &kp N1           &kp N2          &kp N3           &kp N4           &kp N5             &mmv MOVE_DOWN   &kp N6           &kp N7           &kp N8      &kp N9     &kp N0        &kp EQUAL
&trans      &kp TILDE        &trans          &trans           &trans           &mkp MB5           &mmv MOVE_LEFT   &kp LEFT         &kp DOWN         &kp UP      &kp RIGHT  &kp K_VOL_UP  &kp PSCRN
&trans      &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_SPI    &mmv MOVE_RIGHT  &kp HOME         &kp PG_DN        &kp PG_UP   &kp END    &kp K_VOL_DN  &trans
&kp C_MUTE  &trans           &trans          &trans           &trans           &trans             &mkp LCLK        &trans           &trans           &trans      &trans     &trans
            >;

            display-name = "nav";
        };

        sym_layer {
            bindings = <
&kp TILDE  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &mmv MOVE_UP     &kp F6    &kp F7    &kp F8       &kp F9       &kp F10      &trans
&trans     &bt BT_CLR    &bt BT_CLR_ALL  &trans        &trans        &trans          &mmv MOVE_DOWN   &trans    &trans    &kp F11      &kp F12      &kp UNDER    &kp PLUS
&trans     &out OUT_USB  &out OUT_BLE    &trans        &trans        &trans          &mmv MOVE_LEFT   &kp MINUS &kp EQUAL &kp LBRC     &kp RBRC     &kp LBRC     &kp RBRC
&trans     &sys_reset    &trans          &bootloader   &trans        &trans          &mmv MOVE_RIGHT  &kp UNDER &kp PLUS  &kp LS(LBRC) &kp LS(RBRC) &bootloader  &trans
&trans     &trans        &trans          &trans        &trans        &trans          &mkp LCLK        &trans    &trans    &trans       &trans       &trans
            >;

            display-name = "sym";
        };
    };
};



